# Copy to .env or run: python scripts/credentials.py init
# Paste values only into .env. Never commit that file or paste keys into chat.
# Start with Runpod; the other services can be configured later.
RUNPOD_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: required for Anthropic keys that are not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
HF_TOKEN=
